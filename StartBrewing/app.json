{
  "expo": {
    "name": "StartBrewing",
    "slug": "StartBrewing",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "startbrewing",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "manifest": {
        "name": "StartToBrew",
        "shortName": "StartToBrew",
        "start_url": ".",
        "display": "standalone",
        "backgroundColor": "#ffffff",
        "themeColor": "#000000",
        "orientation": "portrait"
      },
      "serviceWorker": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-image-picker",
      {
      "photosPermission": "De app heeft toegang tot je foto's nodig om afbeeldingen te kunnen uploaden.",
      "cameraPermission": "De app heeft toegang tot de camera nodig om een foto te maken."
    }
  ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
